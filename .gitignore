.aider*


# ==============================================================================
# IMPORTANT VERSION-CONTROL RULES
# ==============================================================================
#
# KEEP TRACKED:
#
# package.json
# package-lock.json
# components.json
#
# next.config.mjs
# tsconfig.json
# eslint.config.mjs
# postcss.config.mjs
# proxy.ts
# netlify.toml
#
# .github/
# docs/
# assets/
# THE-GAMING-HORIZON/
#
# Supabase migrations:
# **/supabase/migrations/
#
# Root documentation and governance:
# README.md
# BRAND.md
# CHANGELOG.md
# CODE_OF_CONDUCT.md
# CONTRIBUTING.md
# COPYRIGHT.md
# LICENSE
# PRIVACY.md
# ROADMAP.md
# SECURITY.md
# SUPPORT.md
# TERMS.md
# THIRD-PARTY-NOTICES.md
#
# NEVER COMMIT:
#
# passwords
# API keys
# access tokens
# private keys
# service-role credentials
# bot tokens
# deployment credentials
# database credentials
# webhook secrets
# session secrets
# local environment files
#
# ==============================================================================
